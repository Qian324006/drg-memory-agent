# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 环境变量：密钥不要进版本库 ----
.env

# ---- 数据：向量库由 scripts/ingest_knowledge.py 生成，不需要版本管理 ----
data/chroma/

# 会话历史：里面是真实的聊天记录，不该进版本库。
# 必须带星号：sqlite 开着 WAL 模式时会额外生成 -shm / -wal 两个边车文件，
# 它们装的同样是真实对话内容。只写 data/checkpoints.sqlite 会漏掉这两个。
data/checkpoints.sqlite*

# ---- 运行日志 ----
logs/
# 曾经的一个 bug 会在根目录生成这个同名文件，别让它进版本库
LOG_DIR

# ---- 编辑器 / notebook ----
.idea/
.vscode/
.ipynb_checkpoints/
